# Optional environment for the Muer quick-start consumer. Local demo values
# only — never reuse them in another environment.
#
# The bundled docker-compose.yml provisions MySQL (database `iam_example`,
# user `iam`, password `iam-secret`) and Redis 7 on localhost. The quick-start
# application.yml defaults already match it, so you only need to override what
# differs in your setup.

# Database / Redis connection (defaults match the local compose).
MUER_JDBC_URL=jdbc:mysql://localhost:3306/iam_example
MUER_DB_USERNAME=iam
MUER_DB_PASSWORD=iam-secret
MUER_REDIS_HOST=localhost
MUER_REDIS_PORT=6379

# Dev-only authorization seeding. Keep OFF outside local development.
MUER_QUICKSTART_SEED_DEMO=true

# The seeder and the demo login flow expect the dev profile.
SPRING_PROFILES_ACTIVE=dev
